# Optional explicit browser-facing API origin for frontend requests with credentials.
# If unset, the app derives an API hostname by adding `-api` to the first host label.
# Google OAuth client id/secret and allowlist values are backend-only env vars.
VITE_API_BASE_URL=http://localhost:3000

# Server-only trusted backend origin for authenticated server rendering.
SPLICE_INTERNAL_API_BASE_URL=http://localhost:3000
