FROM node:20-bullseye

WORKDIR /app

# Copy package files
COPY package.json yarn.lock ./

# Install dependencies and Playwright browsers
RUN yarn install --frozen-lockfile && \
    npx playwright install --with-deps

# Copy source code
COPY . .

# Expose port
EXPOSE 3000

# Start in development mode with watch mode
CMD ["yarn", "start:dev"]
