# Application
PORT=3000
NODE_ENV=development

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=splice_dev
POSTGRES_USER=splice_user
POSTGRES_PASSWORD=splice_password

# Plaid (https://dashboard.plaid.com/developers/keys)
PLAID_CLIENT_ID=
PLAID_SECRET=

# JWT
JWT_SECRET=

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/user/oauth/google/callback
GOOGLE_ALLOWED_EMAILS=

# Public frontend origin allowed by CORS and used for cookie domain calculation
FRONTEND_DOMAIN=http://localhost:4000

# Public API origin used in outbound links and webhook callbacks
API_DOMAIN=http://localhost:3000

# Staging Database (for sync script)
STAGE_DB_HOST=<staging db hostname>
STAGE_DB_PORT=<staging db port>
STAGE_DB_NAME=splice_dev
STAGE_DB_USER=splice_user
STAGE_DB_PASSWORD=splice_password

# Alchemy (Ethereum RPC)
ALCHEMY_API_KEY=

# Logging (Seq)
SEQ_SERVER_URL=
SEQ_API_KEY=
