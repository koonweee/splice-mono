# Application
PORT=3000
NODE_ENV=development

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=splice_dev
POSTGRES_USER=splice_user
POSTGRES_PASSWORD=splice_password

# Plaid (https://dashboard.plaid.com/developers/keys)
PLAID_CLIENT_ID=
PLAID_SECRET=

# JWT
JWT_SECRET=

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/user/oauth/google/callback
GOOGLE_ALLOWED_EMAILS=

# Local dev auth bypass
# Development only. Never enable in production.
LOCAL_AUTH_BYPASS=false
LOCAL_AUTH_BYPASS_EMAIL=

# Public frontend origin allowed by CORS and used for cookie domain calculation
FRONTEND_DOMAIN=http://localhost:4000

# Public API origin used in outbound links and webhook callbacks
API_DOMAIN=http://localhost:3000

# Standalone OAuth-protected MCP resource. Disabled by default for local API work.
MCP_ENABLED=false
MCP_PORT=3001
MCP_SERVER_URL=https://splice-mcp.kw0.dev/mcp
AUTH0_ISSUER=https://auth.kw0.dev/
MCP_ALLOWED_HOSTNAMES=splice-mcp.kw0.dev
MCP_ALLOWED_ORIGIN_HOSTNAMES=chatgpt.com,chat.openai.com

# Browser push notifications (generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Staging Database (for sync script)
STAGE_DB_HOST=<staging db hostname>
STAGE_DB_PORT=<staging db port>
STAGE_DB_NAME=splice_dev
STAGE_DB_USER=splice_user
STAGE_DB_PASSWORD=splice_password

# Alchemy (Ethereum RPC)
ALCHEMY_API_KEY=

# OpenAI / AI recommendations
OPENAI_API_KEY=
CATEGORIZATION_RULE_RECOMMENDER_MODEL=gpt-5.4-mini
CATEGORIZATION_RULE_RECOMMENDER_MAX_TOOL_STEPS=30

# Logging (Seq)
SEQ_SERVER_URL=
SEQ_API_KEY=
